# Copy to .env on the Alerty host. Never commit real credentials.
ALERTY_PORT=8080

# URLs must be reachable from inside the Alerty container.
# Examples: http://192.168.1.20:9090 or http://host.docker.internal:9090
PROMETHEUS_URL=
PROMETHEUS_TOKEN=
PROMETHEUS_USER=
PROMETHEUS_PASSWORD=

LOKI_URL=
LOKI_TOKEN=
LOKI_USER=
LOKI_PASSWORD=

UPSTREAM_TIMEOUT_MS=8000

